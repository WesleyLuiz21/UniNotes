# UniNotes production configuration. Copy to .env and fill in (chmod 600 .env).
# Never commit .env.

# Project name: prefixes containers, volumes and networks so they don't clash with other stacks.
COMPOSE_PROJECT_NAME=uninotes

# Public URL users open in the browser (scheme + host, no trailing slash).
UNINOTES_ORIGIN=https://notes.example.com

# 32+ random bytes. Generate with: openssl rand -base64 48
# Encrypts MFA secrets and keys recovery-code hashes. Store a copy in your password manager:
# restoring a backup on a new server needs the same value.
APP_SECRET_KEY=

# ---------- Reverse proxy mode ----------
# Option A (default): bundled Caddy serves HTTPS directly with automatic certificates.
#   Requires DNS for the domain pointing at this VPS and ports 80/443 free.
UNINOTES_SITE_ADDRESS=notes.example.com
UNINOTES_HTTP_BIND=0.0.0.0
UNINOTES_HTTP_PORT=80
UNINOTES_HTTPS_BIND=0.0.0.0
UNINOTES_HTTPS_PORT=443
#
# Option B: an existing reverse proxy (nginx, Traefik, another Caddy…) already owns 80/443.
#   UNINOTES_SITE_ADDRESS=:80
#   UNINOTES_HTTP_BIND=127.0.0.1
#   UNINOTES_HTTP_PORT=8088            # point your existing proxy at http://127.0.0.1:8088
#   UNINOTES_HTTPS_BIND=127.0.0.1
#   UNINOTES_HTTPS_PORT=8443           # unused in this mode, keep it on loopback
#   UNINOTES_TRUSTED_PROXIES=172.16.0.0/12   # Docker gateway range your host proxy's traffic arrives from
# Keep UNINOTES_ORIGIN as the public https:// URL and UNINOTES_COOKIE_SECURE=true.
# Whose X-Forwarded-For header to trust. Leave as 127.0.0.1/32 (= nobody) in Option A.
# Never trust broad ranges when Caddy is directly exposed: clients could then spoof their IP and
# evade per-IP login limits.
UNINOTES_TRUSTED_PROXIES=127.0.0.1/32
UNINOTES_COOKIE_SECURE=true

# ---------- Application ----------
LOG_LEVEL=info
SESSION_IDLE_DAYS=7
SESSION_ABSOLUTE_DAYS=30
MAX_IMAGE_MB=10
MAX_ATTACHMENT_MB=25
MAX_IMPORT_MB=2
VERSION_RETENTION=100
# 0 = never auto-empty the recycle bin
RECYCLE_BIN_RETENTION_DAYS=0

# ---------- Backups ----------
# Local verified snapshots kept in the "backups" volume.
LOCAL_BACKUP_KEEP=7
# Offsite encrypted backups with restic (leave RESTIC_REPOSITORY empty to disable).
# Examples:
#   s3:https://s3.eu-central-1.amazonaws.com/my-bucket/uninotes   (+ AWS_* below)
#   b2:my-bucket:uninotes                                          (+ B2_* below)
#   rest:https://user:pass@backup.example.com/uninotes
#   /repo   (a directory on this host, mounted from RESTIC_LOCAL_REPO_DIR — for testing or an attached disk)
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
RESTIC_LOCAL_REPO_DIR=./restic-repo
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=
# Retention for offsite snapshots
RESTIC_KEEP_DAILY=30
RESTIC_KEEP_WEEKLY=8
RESTIC_KEEP_MONTHLY=6
# Optional: URL pinged on success; "<url>/fail" on failure (e.g. healthchecks.io, Uptime Kuma push).
BACKUP_NOTIFY_URL=

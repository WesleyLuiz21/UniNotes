# UniNotes production configuration (VPS: university.wesleyldshub.dev behind the host Caddy).
# Copy to .env in /srv/UniNotes/app, fill in, then: chmod 600 .env
# Never commit .env. Generate secrets ON THE VPS.

# ---------- Required ----------
# Public URL users open in the browser (https, no trailing slash). Used for CSRF/Origin checks.
UNINOTES_ORIGIN=https://university.wesleyldshub.dev

# 32+ random characters. Generate with: openssl rand -base64 48
# Encrypts MFA secrets and keys recovery-code hashes. Keep a copy in your password manager:
# restoring a backup that has MFA enrolled needs the same value.
APP_SECRET_KEY=

# ---------- Deployment layout (defaults match the VPS; change only when testing elsewhere) ----------
# Which compose file the scripts drive. The VPS must use compose.existing-proxy.yaml
# (compose.yaml starts its own Caddy on 80/443 and is NOT for this host).
UNINOTES_COMPOSE_FILE=compose.existing-proxy.yaml
# Persistent data (bind mounts, owned by uid 1000, mode 700) and local backups. Keep outside the repo.
UNINOTES_DATA_DIR=/srv/UniNotes/data
UNINOTES_BACKUP_DIR=/srv/UniNotes/backups
# Where deploy.sh records the current/previous release tags (outside the repo).
UNINOTES_STATE_DIR=/srv/UniNotes
# Loopback ports the host Caddy proxies to (3001 is the Notes API; never use it).
UNINOTES_BACKEND_HOST_PORT=3002
UNINOTES_FRONTEND_HOST_PORT=3003
# IPv4 address the domain must resolve to (checked by scripts/preflight.sh).
UNINOTES_EXPECTED_IP=178.62.99.141
# Container memory limits (1.9 GiB host shared with the Notes app).
UNINOTES_BACKEND_MEM_LIMIT=512m
UNINOTES_FRONTEND_MEM_LIMIT=64m
# Do not set UNINOTES_TAG here: scripts use the tag recorded by deploy.sh.
UNINOTES_COOKIE_SECURE=true

# ---------- Application ----------
LOG_LEVEL=info
SESSION_IDLE_DAYS=7
SESSION_ABSOLUTE_DAYS=30
MAX_IMAGE_MB=10
# Keep in sync with "request_body max_size" in deploy/Caddyfile.university (limit + multipart overhead).
MAX_ATTACHMENT_MB=25
MAX_IMPORT_MB=2
VERSION_RETENTION=100
# 0 = never auto-empty the recycle bin
RECYCLE_BIN_RETENTION_DAYS=0

# ---------- Backups ----------
# Verified local snapshots (database + attachments + manifest) kept in UNINOTES_BACKUP_DIR/local.
LOCAL_BACKUP_KEEP=14
# Offsite encrypted backups with restic (strongly recommended: local backups do not survive the
# loss of the droplet). Leave RESTIC_REPOSITORY empty to disable. Examples:
#   s3:https://ams3.digitaloceanspaces.com/<bucket>/uninotes   (DigitalOcean Spaces; AWS_* below)
#   b2:<bucket>:uninotes                                         (Backblaze B2; B2_* below)
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
RESTIC_LOCAL_REPO_DIR=./restic-repo
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=
RESTIC_KEEP_DAILY=30
RESTIC_KEEP_WEEKLY=8
RESTIC_KEEP_MONTHLY=6
# Optional: URL pinged on success; "<url>/fail" on failure (e.g. healthchecks.io).
BACKUP_NOTIFY_URL=

# ---------- Only for compose.yaml (bundled Caddy; NOT used on the VPS) ----------
# COMPOSE_PROJECT_NAME=uninotes
# UNINOTES_SITE_ADDRESS=university.example.com
# UNINOTES_HTTP_BIND=0.0.0.0
# UNINOTES_HTTP_PORT=80
# UNINOTES_HTTPS_BIND=0.0.0.0
# UNINOTES_HTTPS_PORT=443
# UNINOTES_TRUSTED_PROXIES=127.0.0.1/32

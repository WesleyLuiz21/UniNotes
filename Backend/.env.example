# Local development settings for the backend (copy to Backend/.env).
NODE_ENV=development
PORT=3000
DATA_DIR=./data
# 32+ random bytes, base64. Generate: openssl rand -base64 32
APP_SECRET_KEY=change-me-generate-with-openssl-rand-base64-32
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
LOG_LEVEL=debug

# Static file server for the built SPA (runs inside the frontend container, unprivileged, port 8080).
# Security headers are set here so they apply whether the edge proxy is the bundled Caddy or an
# existing reverse proxy on the VPS.
{
	admin off
	auto_https off
	persist_config off
	log {
		output stdout
		format json
		level WARN
	}
}

:8080 {
	root * /srv
	encode zstd gzip

	header {
		# 'unsafe-inline' is limited to styles (CodeMirror, KaTeX and Shiki set inline styles).
		# No inline or remote scripts, no eval, no framing, no external connections.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; frame-src 'none'; manifest-src 'self'"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	# Content-hashed build assets can be cached forever; HTML must always be revalidated so a
	# deployment is picked up immediately.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@html path / /index.html
	header @html Cache-Control "no-cache"

	# The API is served by the backend; never answer /api with the SPA shell.
	handle /api/* {
		respond "Not found" 404
	}

	handle /healthz {
		respond "ok" 200
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}

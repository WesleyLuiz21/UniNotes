# Edge reverse proxy for UniNotes.
#
#   https://YOUR_DOMAIN/        -> frontend:8080  (static SPA)
#   https://YOUR_DOMAIN/api/*   -> backend:3000   (/api prefix preserved)
#
# UNINOTES_SITE_ADDRESS controls the mode (see .env.example):
#   notes.example.com  -> Caddy obtains and renews a TLS certificate automatically (needs ports 80/443)
#   :80                -> plain HTTP, for running behind an existing reverse proxy that terminates TLS
{
	admin off
	servers {
		# Whose X-Forwarded-For to believe. Default (127.0.0.1/32) = nobody, which is correct when
		# this Caddy faces the internet directly. Only widen it behind an existing proxy (Option B).
		trusted_proxies static {$UNINOTES_TRUSTED_PROXIES:127.0.0.1/32}
		# Read X-Forwarded-For right-to-left, skipping only trusted proxies. Without this Caddy takes
		# the LEFTMOST entry, which a client can forge whenever an upstream proxy appends to the header.
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
		# Slow-client (slowloris) protection.
		timeouts {
			read_header 10s
			read_body 5m
			write 15m
			idle 2m
		}
		max_header_size 32KB
	}
	log {
		output stdout
		format json
		level INFO
	}
}

{$UNINOTES_SITE_ADDRESS:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
		-Via
	}

	# Upper bound for request bodies (largest upload limit + multipart overhead).
	request_body {
		max_size 40MB
	}

	handle /api/* {
		reverse_proxy backend:3000 {
			# Replace (never append to) X-Forwarded-For with the client IP Caddy determined, so the
			# backend's per-IP limits and audit log cannot be fooled by a spoofed header.
			header_up X-Forwarded-For {client_ip}
			# Retry briefly while the backend restarts (e.g. during a backend-only redeploy).
			lb_try_duration 15s
			lb_try_interval 500ms
		}
	}

	handle {
		reverse_proxy frontend:8080 {
			lb_try_duration 10s
		}
	}
}
